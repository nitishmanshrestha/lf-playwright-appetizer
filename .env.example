# Application Base URL
# For local development: http://localhost:3000
# For CI/QA environments: use environment-specific configs
BASE_URL=http://localhost:3000

# CI Environment Flag
# Set to true in CI pipelines to run with 1 worker and 2 retries
# CI=true

# Auth Credentials (if needed for your app)
# AUTH_USERNAME=user@example.com
# AUTH_PASSWORD=password123

# Saucedemo Demo App (optional, used in saucedemo tests)
# SAUCEDEMO_USERNAME=standard_user
# SAUCEDEMO_PASSWORD=secret_sauce
