# Base URL for the app under test
BASE_URL=http://localhost:3000

# Auth URL (used by global.setup.ts)
AUTH_URL=/login

# Credentials (use secrets manager in CI)
USERNAME=admin
PASSWORD=password

# Set to true to run global auth setup project
RUN_GLOBAL_AUTH=

# Playwright trace mode: on | off | on-first-retry
PW_TRACE=on-first-retry

# Set to 1 to re-record HAR files from real network
UPDATE_HAR=
