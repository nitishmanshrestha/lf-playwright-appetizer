{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-validate-playwright-rules.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validate-playwright-rules.mjs"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "~/.claude/projects/playwright-boilerplate/memory",
  "env": {
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "0"
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run report*)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm run check:*)",
      "Bash(npm run scaffold:*)",
      "Bash(npx playwright*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(grep -r* playwright/*)",
      "Bash(find playwright/*)"
    ],
    "deny": ["WebSearch"]
  }
}
