{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(node *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)"
    ],
    "defaultMode": "auto"
  },
  "env": {
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "0",
    "DEBUG": "pw:api"
  },
  "model": "claude-haiku-4-5-20251001",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "~/.claude/projects/playwright-boilerplate/memory"
}
