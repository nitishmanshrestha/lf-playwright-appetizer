# Dependencies
node_modules/

# Playwright run artifacts
test-results/
playwright-report/
blob-report/

# Playwright CLI / MCP local runtime state
.playwright/
.playwright-cli/
.playwright-mcp/

# Framework evidence outputs (generated)
playwright/evidence/bootstrap/
playwright/evidence/tests/

# Generated normalized evidence; keep evidence/requirements.json tracked.
evidence/runs/
evidence/coverage-computed.json
evidence/metrics.json

# Auth and captured runtime artifacts
playwright/.auth/
playwright/.context-capture/
playwright/fixtures/har/
# Un-ignore HAR files explicitly when you want them committed:
# !playwright/fixtures/har/payments/list.har

# Environment files
.env
.env.*
!.env.example
playwright/environments/.env.*
!playwright/environments/.env.qa.example

# Claude Code personal settings and caches
.claude/settings.local.json
.claude/**/*.cache

# OS/editor noise
.DS_Store
Thumbs.db

# GSD Core runtime. Installed per person by `node scripts/engine/install-gsd.mjs` (CI runs it too);
# it writes machine-specific paths, so it is never committed.
/.*/gsd-core/
/.*/gsd-migration-journal/
/.*/gsd-file-manifest.json
/.*/gsd-install-state.json
/.*/.gsd-profile
/.*/agents/gsd-*
/.*/commands/gsd-*
/.*/hooks/gsd-*
/.*/hooks/lib/
/.*/skills/gsd-*
/.claude/scripts/
/.cursor/scripts/
/.codex/scripts/
/.github/scripts/
/.codex/config.toml
/.codex/hooks.json
/.*/hooks/managed-hooks-registry.cjs
/.*/hooks/package.json
/.gsd/
/.gsd-capabilities.json
