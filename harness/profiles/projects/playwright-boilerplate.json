{
  "$comment": "Profile for the Playwright boilerplate itself — the reference instantiation of the playwright adapter. Every field below is a project fact; all policy comes from adapters/playwright.json.",
  "key": "playwright-boilerplate",
  "displayName": "Playwright Automation Boilerplate",
  "owner": "Nitish Shrestha",
  "adapter": "playwright",
  "language": "typescript",
  "projectName": "playwright-automation-boilerplate",
  "repo": "lf-playwright-boilerplate",
  "pattern": "helper-first",
  "paths": {
    "testRoot": "playwright",
    "configRoot": "playwright/configs",
    "commandRoot": "playwright/support/helpers",
    "specGlob": "playwright/tests/**/*.spec.ts"
  },
  "wiring": {
    "packageManager": "npm",
    "workspacePackage": false,
    "verifyScript": "npm run verify"
  },
  "strategy": {
    "auth": "storage-state",
    "testData": "fresh",
    "credentialSource": "ci-secret"
  },
  "adapters": {
    "claude": {
      "enabled": true
    },
    "copilot": {
      "enabled": true
    }
  },
  "locked": true
}
