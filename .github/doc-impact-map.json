{
  "rules": [
    {
      "trigger": ["playwright.config.ts"],
      "docs": ["README.md", "docs/04-reference/config-reference.md"]
    },
    {
      "triggerPrefix": ["playwright/configs/app/"],
      "docs": ["README.md", "docs/04-reference/config-reference.md"]
    },
    {
      "triggerPrefix": ["playwright/configs/api/"],
      "docs": ["docs/02-guides/api-mocking.md", "docs/02-guides/writing-tests.md"]
    },
    {
      "triggerPrefix": ["playwright/configs/ui/"],
      "docs": ["docs/02-guides/selector-strategies.md", "docs/02-guides/writing-tests.md"]
    },
    {
      "triggerPrefix": ["playwright/support/helpers/"],
      "docs": ["docs/02-guides/writing-tests.md", "docs/05-architecture/three-layer-pattern.md"]
    },
    {
      "triggerPrefix": ["playwright/tests/"],
      "docs": ["docs/02-guides/writing-tests.md", "docs/01-getting-started/first-test-module.md"]
    },
    {
      "triggerPrefix": ["playwright/fixtures/"],
      "docs": ["docs/02-guides/writing-tests.md", "docs/03-features/session-and-auth.md"]
    },
    {
      "trigger": ["scripts/bootstrap.js"],
      "docs": ["README.md", "docs/01-getting-started/setup.md"]
    },
    {
      "trigger": ["scripts/check-locator-strategy.js"],
      "docs": ["docs/02-guides/selector-strategies.md", "docs/02-guides/writing-tests.md"]
    }
  ]
}
