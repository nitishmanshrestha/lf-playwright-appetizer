{
  "rules": [
    {
      "trigger": ["playwright.config.ts"],
      "docs": ["README.md", "docs/reference/config-reference.md"]
    },
    {
      "triggerPrefix": ["playwright/configs/app/"],
      "docs": ["README.md", "docs/reference/config-reference.md"]
    },
    {
      "triggerPrefix": ["playwright/configs/api/"],
      "docs": ["docs/guides/api-mocking.md", "docs/guides/writing-tests.md"]
    },
    {
      "triggerPrefix": ["playwright/configs/ui/"],
      "docs": ["docs/guides/selector-strategies.md", "docs/guides/writing-tests.md"]
    },
    {
      "triggerPrefix": ["playwright/support/helpers/"],
      "docs": ["docs/guides/writing-tests.md", "docs/architecture/three-layer-pattern.md"]
    },
    {
      "triggerPrefix": ["playwright/tests/"],
      "docs": ["docs/guides/writing-tests.md", "docs/guides/first-test-module.md"]
    },
    {
      "triggerPrefix": ["playwright/fixtures/"],
      "docs": ["docs/guides/writing-tests.md", "docs/guides/session-and-auth.md"]
    },
    {
      "trigger": ["scripts/bootstrap.js"],
      "docs": ["README.md", "docs/guides/setup.md"]
    },
    {
      "trigger": ["scripts/check-locator-strategy.js"],
      "docs": ["docs/guides/selector-strategies.md", "docs/guides/writing-tests.md"]
    }
  ]
}
